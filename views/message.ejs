<!DOCTYPE html>
<html lang="en">
  <%- include("partials/head") %>
  <body>
    <%- include("partials/nav") %>
    <main>
      <h1>Message</h1>
        <h2><%= message.name %></h2>
        <p><%= message.message %></p>
        <p><%= message.added %></p>
        <form action="/message/<%= message.id %>" method="POST">
        <div>
          <input type="hidden" name="id" value="<%= message.id %>">
        </div>
          <button type="submit" class="delete-btn">Delete</button>
        </form>
    </main>
  </body>
</html>